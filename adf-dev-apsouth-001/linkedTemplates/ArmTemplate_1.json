						"products derive(UPDATED_TIMESTAMP = currentTimestamp()) ~> derivedColumn1",
						"derivedColumn1 cast(output(",
						"          STORE_ID as integer,",
						"          WEB_ADDRESS as double,",
						"          LONGITUDE as double",
						"     ),",
						"     errors: true) ~> cast3",
