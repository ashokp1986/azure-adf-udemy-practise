{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dev-apsouth-001"
		},
		"ls_azure_blob_storage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_azure_blob_storage'"
		},
		"ls_cleaned_customer_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_cleaned_customer'"
		},
		"ls_dl_orders_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_dl_orders'"
		},
		"ls_st_orders_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_st_orders'"
		},
		"sqlserver_order_dev_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sqlserver_order_dev'"
		},
		"ls_cleaned_customer_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlstoragedevorders001.dfs.core.windows.net/"
		},
		"ls_dl_orders_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlstoragedevorders001.dfs.core.windows.net/"
		},
		"sqlserver_order_dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver-orders-dev-1.database.windows.net"
		},
		"sqlserver_order_dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-orders-dev"
		},
		"sqlserver_order_dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"tg_storage_event_test_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/e1cd3b9d-9afb-4f5f-927a-95cac124257b/resourceGroups/rg-orders-dev-apsouth-001/providers/Microsoft.Storage/storageAccounts/storagedevorders001"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-dev-apsouth-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azure_blob_storage_connectionString": {
						"value": "[parameters('ls_azure_blob_storage_connectionString')]"
					},
					"ls_cleaned_customer_accountKey": {
						"value": "[parameters('ls_cleaned_customer_accountKey')]"
					},
					"ls_dl_orders_accountKey": {
						"value": "[parameters('ls_dl_orders_accountKey')]"
					},
					"ls_st_orders_connectionString": {
						"value": "[parameters('ls_st_orders_connectionString')]"
					},
					"sqlserver_order_dev_password": {
						"value": "[parameters('sqlserver_order_dev_password')]"
					},
					"ls_cleaned_customer_properties_typeProperties_url": {
						"value": "[parameters('ls_cleaned_customer_properties_typeProperties_url')]"
					},
					"ls_dl_orders_properties_typeProperties_url": {
						"value": "[parameters('ls_dl_orders_properties_typeProperties_url')]"
					},
					"sqlserver_order_dev_properties_typeProperties_server": {
						"value": "[parameters('sqlserver_order_dev_properties_typeProperties_server')]"
					},
					"sqlserver_order_dev_properties_typeProperties_database": {
						"value": "[parameters('sqlserver_order_dev_properties_typeProperties_database')]"
					},
					"sqlserver_order_dev_properties_typeProperties_userName": {
						"value": "[parameters('sqlserver_order_dev_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-dev-apsouth-001_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-dev-apsouth-001_ArmTemplate_0')]"
			]
		},
		{
			"name": "adf-dev-apsouth-001_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"tg_storage_event_test_properties_typeProperties_scope": {
						"value": "[parameters('tg_storage_event_test_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-dev-apsouth-001_ArmTemplate_1')]"
			]
		}
	]
}