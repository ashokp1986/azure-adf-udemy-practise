{
	"name": "df_stores_cleaned_to_structured",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_cleansed_stores",
						"type": "DatasetReference"
					},
					"name": "stores"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "df_stuct_stores",
						"type": "DatasetReference"
					},
					"name": "structuredproduct"
				}
			],
			"transformations": [
				{
					"name": "addcustomfields"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> stores",
				"stores derive(UPDATED_TIMESTAMP = currentTimestamp()) ~> addcustomfields",
				"addcustomfields sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> structuredproduct"
			]
		}
	}
}